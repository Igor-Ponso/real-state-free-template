APP_NAME="Sovereign Estates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is the primary database (see CLAUDE.md).
# SQLite is used only in automated tests via phpunit.xml.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=real_state
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Storage — default to local public disk so `php artisan storage:link` + `storage/app/public`
# serves uploaded media without external dependencies. Swap to `s3` (works with AWS S3,
# Cloudflare R2, DigitalOcean Spaces, Bunny Storage, or any S3-compatible provider) for
# production. See README "Production storage" section for a walkthrough.
FILESYSTEM_DISK=local

# Media disk — where Spatie MediaLibrary stores property photos and floor plans.
# Local dev: `public` (maps to storage/app/public via storage:link).
# Production: set to `s3` and fill the AWS_* vars below.
MEDIA_DISK=public

# Image driver — `gd` (default, bundled with PHP) or `imagick` (better JPEG quality,
# HEIC/TIFF support). Imagick recommended for production.
IMAGE_DRIVER=gd

# Queue Spatie MediaLibrary conversions? false = synchronous (simpler, slower uploads).
# true + QUEUE_CONNECTION=redis = production setting.
QUEUE_CONVERSIONS_BY_DEFAULT=false

QUEUE_CONNECTION=database

# Cache — Redis REQUIRED for production (Cache::tags used for granular invalidation).
# Without Redis, cache tag operations silently fail and stale data may persist.
# For local dev without Redis: set to 'file' or 'array' (tags won't work but app functions).
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — defaults to 'log' (writes to storage/logs instead of sending)
# For testing: use Mailtrap (https://mailtrap.io) — free SMTP sandbox
# For production: use SendGrid, Mailgun, Postmark, or Amazon SES
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible object storage (optional — for media uploads in production).
# Works with AWS S3, Cloudflare R2, DigitalOcean Spaces, Bunny Storage, Backblaze B2.
#
# Cloudflare R2 is recommended: S3-compatible API, $0.015/GB/month storage,
# ZERO egress (CDN reads are free). Leave FILESYSTEM_DISK=local during development.
#
# Example R2 config:
#   FILESYSTEM_DISK=s3
#   MEDIA_DISK=s3
#   AWS_ACCESS_KEY_ID=<R2 token key>
#   AWS_SECRET_ACCESS_KEY=<R2 token secret>
#   AWS_DEFAULT_REGION=auto
#   AWS_BUCKET=sovereign-estates-media
#   AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_URL=https://cdn.yourdomain.com          (custom domain in front of R2)
#   AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CipherSweet encryption key for PII fields (users.email, inquiries.email, etc.)
# Generate with: php artisan ciphersweet:generate-key
# CRITICAL: Once set, NEVER regenerate — encrypted data becomes unrecoverable.
CIPHERSWEET_KEY=

# Social login providers (optional — leave empty to disable social login).
# The frontend automatically hides social buttons when client_id is empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Nominatim geocoding (OpenStreetMap). Free, no API key required.
# Set NOMINATIM_USER_AGENT to something identifying your deployment,
# per Nominatim usage policy: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="SovereignEstates/1.0 (your-email@example.com)"
NOMINATIM_CACHE_TTL=2592000
NOMINATIM_TIMEOUT=5

# Demo deployment flag — when true, properties without uploaded media show
# the local placeholder images from public/images/properties/.
# Always set to false in real production deployments.
SHOW_PLACEHOLDER_IMAGES=false
